load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//private:remote_caching.bzl", "remote_caching_setting")
load("//rules:eac.bzl", "cfg6_eac_argument")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//build:package_group"],
)

cfg6_eac_argument(
    name = "false",
    value = "false",
)

cfg6_eac_argument(
    name = "true",
    value = "true",
)

remote_caching_setting(
    name = "remote_cache",
    build_setting_default = "",
)

string_flag(
    name = "extra_jvm_args",
    build_setting_default = "",
)
