# https://registry.bazel.build/modules/stardoc
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
# https://registry.bazel.build/modules/rules_java
bazel_dep(name = "rules_java", version = "9.6.1", dev_dependency = True)
# https://registry.bazel.build/modules/rules_kotlin
bazel_dep(name = "rules_kotlin", version = "2.2.2", dev_dependency = True)
# https://registry.bazel.build/modules/bazel_skylib
bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)
# https://registry.bazel.build/modules/rules_shell
bazel_dep(name = "rules_shell", version = "0.7.1", dev_dependency = True)
# https://registry.bazel.build/modules/rules_pkg
bazel_dep(name = "rules_pkg", version = "1.2.0", dev_dependency = True)
# https://registry.bazel.build/modules/rules_go
# transitive dep of rules_kotlin (via rules_android); older versions are incompatible with Bazel 9
bazel_dep(name = "rules_go", version = "0.59.0", dev_dependency = True)

# patching rules shell for stardoc
single_version_override(
    module_name = "rules_shell",
    patches = ["//build:rules_shell.patch"],
    patch_strip = 1,
)

# patching rules kotlin for stardoc
single_version_override(
    module_name = "rules_kotlin",
    patches = ["//build:rules_kotlin.patch"],
    patch_strip = 1,
)

local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

local_repository(
    name = "rules_cfg6",
    path = "src/rules_cfg6"
)

local_repository(
    name = "rules_dvarjson",
    path = "src/rules_dvarjson"
)

cfg6_archive = use_repo_rule("//src/rules_cfg6:defs.bzl", "cfg6_archive")
cfg6_archive(
    name = "cfg6",
    nupkg_sha256 = "9f1f94054db7cd1d8fff5788c82e5dd4a1445e5d5b8bbaefe72aafd9eda55e96",
    nupkg_url = "https://packages.vehub.vector.com/nuget/flatcontainer/vector-davinci-configurator-classic-evo2-cli/6.4.6/vector-davinci-configurator-classic-evo2-cli.6.4.6.nupkg",
    sha256 = "9d3dd8781382424af0f54db12b5f5893a6ae0848a6e676bfaf40f37425c83eb5",
    url = "https://packages.vehub.vector.com/apt/pool/generic/vector-davinci-configurator-classic/6.4.6/vector-davinci-configurator-classic-evo2-cli-6.4.6.deb",
)
