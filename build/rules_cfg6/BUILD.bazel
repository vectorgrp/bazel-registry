load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")
load("//build:rules.bzl", "build_module", "module_build_props")

name, version, readme_title_substitutions = module_build_props("3.4.2")

bzl_library(
    name = "lib",
    srcs = [
        "//src/rules_cfg6:defs.bzl",
        "//src/rules_cfg6:rules.bzl",
        "@rules_cfg6//:defs.bzl",
        "@rules_cfg6//:rules.bzl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_java//java:rules",
        "@rules_java//java/private:proto_support",
        "@rules_shell//shell:rules_bzl",
        "@rules_shell//shell/private:providers.bzl",
    ],
)

stardoc(
    name = "stardoc",
    out = "stardoc.md",
    input = "//src/rules_cfg6:defs.bzl",
    deps = ["lib"],
)

expand_template(
    name = "readme",
    out = "README.md",
    substitutions = readme_title_substitutions | {"@//src/rules_cfg6": "@rules_cfg6//"},
    template = "stardoc",
)

build_module(
    name = name,
    readme = "readme",
    version = version,
)
