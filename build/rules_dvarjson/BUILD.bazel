load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")
load("//build:rules.bzl", "build_module", "module_build_props")

name, version, readme_title_substitutions = module_build_props("1.1.0")

bzl_library(
    name = "lib",
    srcs = [
        "//src/rules_dvarjson:defs.bzl",
        "//src/rules_dvarjson:rules.bzl",
        "@rules_dvarjson//:defs.bzl",
        "@rules_dvarjson//:rules.bzl",
    ],
    visibility = ["//visibility:public"],
)

stardoc(
    name = "stardoc",
    out = "stardoc.md",
    input = "//src/rules_dvarjson:defs.bzl",
    deps = [
        "lib",
        "//build/rules_cfg6:lib",
    ],
)

expand_template(
    name = "readme",
    out = "README.md",
    substitutions = readme_title_substitutions | {"@//src/rules_dvarjson": "@rules_dvarjson//"},
    template = "stardoc",
)

build_module(
    name = name,
    readme = "readme",
    version = version,
)
